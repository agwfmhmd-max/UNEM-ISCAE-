# ==============================================
#  UNEM ISCAE — نموذج المتغيرات (بدون أسرار حقيقية)
# ==============================================

# --- Supabase (مفاتيح عمومية — يمكن أن تظهر في الواجهة) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# --- Cloudinary ---
# CLOUD_NAME و API_KEY عموميان، لكن API_SECRET سري تماماً
# ويُخزَّن فقط في أسرار Lovable (Project Settings → Secrets)
# ولا يظهر إطلاقاً في index.html أو أي كود يصل للمتصفح.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=NEVER_PUT_THE_REAL_SECRET_IN_THE_FRONTEND

# --- إشعارات Push (Web Push / VAPID) ---
# المفتاح العمومي VAPID_PUBLIC_KEY يمكن أن يظهر في الواجهة (نُقدّمه عبر مسار
# /api/public/push/vapid-key)، أما VAPID_PRIVATE_KEY فسرّي تماماً ويُخزَّن فقط
# في أسرار Lovable (Project Settings → Secrets) — لا تضعه أبداً في الواجهة.
#
# لتوليد زوج مفاتيح جديد (مرة واحدة فقط)، شغّل محلياً:
#   npx web-push generate-vapid-keys
# (هذا الأمر لتوليد المفاتيح فقط — لا حاجة لتثبيت الحزمة في المشروع نفسه،
# فالإرسال الفعلي يتم عبر Web Crypto API المتوافقة مع Cloudflare Workers)
VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=NEVER_PUT_THE_REAL_SECRET_IN_THE_FRONTEND
VAPID_SUBJECT=mailto:contact@unem-iscae.example
